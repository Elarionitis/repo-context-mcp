{
  "name": "repo-context-mcp",
  "version": "2.0.0",
  "private": true,
  "description": "MCP server and CLI that gives AI coding agents a fast, structured picture of any GitHub repository: stack, layout, run commands, files and activity.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "repo-context-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "node src/index.ts",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "package:skill": "node scripts/build-skill.mjs && rm -f repo-context-skill.zip && cd skill && zip -rq ../repo-context-skill.zip repo-context -x '*.DS_Store'"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "github",
    "repository",
    "context",
    "ai-agent",
    "claude-code",
    "cursor",
    "copilot"
  ],
  "author": "Suhan Ramani",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elarionitis/repo-context-mcp.git"
  },
  "homepage": "https://github.com/Elarionitis/repo-context-mcp#readme",
  "bugs": {
    "url": "https://github.com/Elarionitis/repo-context-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
